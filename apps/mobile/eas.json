{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "API_BASE_URL": "https://api.staging.skillsecosystem.co.za/v1" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": { "API_BASE_URL": "https://api.staging.skillsecosystem.co.za/v1" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "API_BASE_URL": "https://api.skillsecosystem.co.za/v1" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID" },
      "android": { "track": "internal", "releaseStatus": "draft" }
    }
  }
}
